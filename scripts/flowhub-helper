#!/usr/bin/env bash
# FlowHub privileged helper.
#
# Installed root-owned at /usr/local/lib/flowhub/flowhub-helper. The public
# flowhub wrapper invokes this through a sudoers allowlist. This helper must
# remain conservative: no arbitrary shell execution, no secret printing, and no
# direct use by unprivileged callers.

set -euo pipefail

INSTALL_DIR="${FLOWHUB_INSTALL_DIR:-/opt/FlowHub}"
ENV_FILE="${INSTALL_DIR}/.env"
COMPOSE_FILE="${INSTALL_DIR}/docker-compose.yml"

die() {
    echo "ERROR: $*" >&2
    exit 1
}

require_root() {
    [[ "${EUID}" -eq 0 ]] || die "flowhub-helper must run as root through the installed flowhub wrapper."
}

ensure_install() {
    [[ -d "$INSTALL_DIR" ]] || die "FlowHub installation directory not found: ${INSTALL_DIR}"
    [[ -f "$COMPOSE_FILE" ]] || die "Docker Compose file not found: ${COMPOSE_FILE}"
    [[ -f "$ENV_FILE" ]] || die "Environment file not found: ${ENV_FILE}"
    cd "$INSTALL_DIR"
}

load_env() {
    set -a
    # shellcheck source=/dev/null
    . "$ENV_FILE"
    set +a
}

# The unprivileged account that owns the checkout. git/docker-compose
# operations run as this user (not as root, even though this helper itself
# runs with root privileges) so that git objects, Docker CLI config, and
# build caches stay owned by the same account that normally operates them.
# Override with FLOWHUB_OPERATOR_USER for installs where the checkout owner
# differs from who should run these commands.
operator_user() {
    if [[ -n "${FLOWHUB_OPERATOR_USER:-}" ]]; then
        echo "$FLOWHUB_OPERATOR_USER"
        return
    fi
    stat -c '%U' "$INSTALL_DIR" 2>/dev/null || echo root
}

run_as_operator() {
    local user home
    user="$(operator_user)"
    if [[ "$user" == "root" ]]; then
        "$@"
        return
    fi
    home="$(getent passwd "$user" 2>/dev/null | cut -d: -f6)"
    sudo -u "$user" -H env HOME="${home:-/root}" "$@"
}

compose_cmd() {
    if docker compose version >/dev/null 2>&1; then
        echo "docker compose"
    elif command -v docker-compose >/dev/null 2>&1; then
        echo "docker-compose"
    else
        die "Docker Compose is not available."
    fi
}

run_compose() {
    local dc
    dc="$(compose_cmd)"
    run_as_operator ${dc} --project-directory "$INSTALL_DIR" -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"
}

health_url() {
    load_env
    echo "http://localhost:${FLOWHUB_PORT:-8085}/api/health"
}

check_app_health() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsS --max-time 3 "$(health_url)" >/dev/null 2>&1
    else
        run_compose exec -T app curl -fsS --max-time 3 http://localhost:8085/api/health >/dev/null 2>&1
    fi
}

wait_for_app_health() {
    local timeout="${1:-60}"
    local start now
    start="$(date +%s)"
    echo "Waiting for FlowHub to become ready at $(health_url) ..."
    while true; do
        if check_app_health; then
            echo "FlowHub is ready."
            return 0
        fi
        now="$(date +%s)"
        if (( now - start >= timeout )); then
            echo "ERROR: FlowHub did not become ready within ${timeout}s." >&2
            return 1
        fi
        sleep 2
    done
}

public_url() {
    load_env
    local domain="${FLOWHUB_DOMAIN:-localhost}"
    local port="${FLOWHUB_PORT:-8085}"
    local ssl_mode="${FLOWHUB_SSL_MODE:-off}"
    case "$ssl_mode" in
        letsencrypt|manual)
            echo "https://${domain}:${port}/"
            ;;
        self-signed)
            echo "https://${domain}:${port}/"
            ;;
        off|*)
            if [[ "$domain" == "localhost" || "$domain" == "127.0.0.1" ]]; then
                echo "http://localhost:${port}/"
            else
                echo "http://${domain}:${port}/"
            fi
            ;;
    esac
}

install_state() {
    if check_app_health; then
        echo "Running"
    elif [[ -n "$(run_compose ps --status running -q app 2>/dev/null)" ]]; then
        echo "Starting"
    else
        echo "Stopped"
    fi
}

api_state() {
    if check_app_health; then
        echo "Healthy"
    elif [[ -n "$(run_compose ps --status running -q app 2>/dev/null)" ]]; then
        echo "Warning"
    else
        echo "Error"
    fi
}

panel_state() {
    case "$(install_state)" in
        Running) echo "Running" ;;
        Starting) echo "Warning" ;;
        *) echo "Stopped" ;;
    esac
}

database_state() {
    load_env
    if run_compose exec -T postgres pg_isready -U "${FLOWHUB_POSTGRES_USER:-flowhub}" -d "${FLOWHUB_POSTGRES_DB:-flowhub}" >/dev/null 2>&1; then
        echo "Healthy"
    else
        echo "Unable to verify"
    fi
}

docker_state() {
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        echo "Running"
    elif command -v docker >/dev/null 2>&1; then
        echo "Installed, not reachable"
    else
        echo "Not installed"
    fi
}

version_commit() {
    if [[ -d "${INSTALL_DIR}/.git" ]]; then
        run_as_operator git -C "$INSTALL_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown"
    else
        echo "unknown"
    fi
}

# ---- Upgrade path (fetch/fast-forward + build/migrate/swap, keeps .env) ----
#
# Refuses on a dirty tree, a non-main branch, or local commits that diverge
# from origin/main (fail closed rather than discarding operator work).
# Migrations run before the running app/runner containers are replaced, so a
# migration failure never leaves half-upgraded runtime containers in place.
safe_upgrade() {
    local status branch counts ahead behind head
    status="$(run_as_operator git -C "$INSTALL_DIR" status --porcelain --untracked-files=no)"
    [[ -z "$status" ]] || die "refusing update: tracked source changes are present."
    branch="$(run_as_operator git -C "$INSTALL_DIR" branch --show-current)"
    [[ "$branch" == "main" ]] || die "refusing update: expected branch main, found ${branch:-detached}."
    run_as_operator git -C "$INSTALL_DIR" fetch origin --prune || die "git fetch failed."
    counts="$(run_as_operator git -C "$INSTALL_DIR" rev-list --left-right --count HEAD...origin/main)"
    read -r ahead behind <<<"$counts"
    [[ "$ahead" == "0" ]] || die "refusing update: local main diverges from origin/main (ahead ${ahead}, behind ${behind})."
    run_as_operator git -C "$INSTALL_DIR" pull --ff-only origin main || die "fast-forward pull failed."
    head="$(run_as_operator git -C "$INSTALL_DIR" rev-parse HEAD)"
    [[ -n "$head" ]] || die "could not verify resulting Git HEAD."
    deploy_current
    echo "Update complete at ${head}."
}

# Build the current checkout's image, migrate the database, then swap the
# running containers onto the new image. If a previous manual rollback left
# a "flowhub-owner-review-current" container around, it is stopped before the
# swap and removed only once the new runtime is confirmed healthy; if the
# swap itself fails, that legacy container is restarted as a fallback.
deploy_current() {
    local legacy="flowhub-owner-review-current"
    run_compose build app || die "image build failed."
    run_compose run --rm flowhub-migrate || die "migration failed; runtime was not replaced."
    if run_as_operator docker container inspect "$legacy" >/dev/null 2>&1; then
        run_as_operator docker stop "$legacy" || die "could not stop current runtime."
    fi
    if ! run_compose up -d --no-deps --force-recreate app order-sync-runner exchange-rate-runner; then
        run_as_operator docker start "$legacy" >/dev/null 2>&1 || true
        die "runtime restart failed; attempted to restore the previous runtime."
    fi
    if run_as_operator docker container inspect "$legacy" >/dev/null 2>&1; then
        run_as_operator docker rm "$legacy" >/dev/null || die "new runtime is healthy but old runtime cleanup failed."
    fi
    wait_for_app_health 60 || die "runtime health check failed."
    verify_migration_head
}

# Compares the migration revision actually applied to the database against
# the head the *currently deployed* code declares (both discovered live from
# the running app container, never hard-coded) so this check keeps working
# unmodified across every future migration, not just the one head that
# happened to be current when this function was written.
verify_migration_head() {
    local expected applied
    expected="$(current_migration_head)"
    applied="$(current_migration_applied)"
    [[ -n "$expected" ]] || die "migration head verification failed: could not determine the code's migration head."
    [[ "$applied" == "$expected" ]] || die "migration head verification failed: database is at '${applied:-none}', code expects '${expected}'."
}

run_app_cli() {
    local first="${1:-}"
    case "$first" in
        admin|diagnostics|configure|migrate|integrations)
            if [[ "$first" == "admin" && "${2:-}" =~ ^(reset-password|reset-username|create)$ && " $* " != *" --help "* ]]; then
                run_compose exec app python -m cli.main "$@"
            else
                run_compose exec -T app python -m cli.main "$@"
            fi
            ;;
        *)
            die "Unsupported app CLI command: ${first:-<empty>}"
            ;;
    esac
}

run_installer() {
    local mode="${1:-}"
    case "$mode" in
        install) bash "${INSTALL_DIR}/installer/install.sh" ;;
        # Deliberately not installer/install.sh's own --upgrade path: that
        # path resets the tracked tree hard to origin/main unconditionally.
        # safe_upgrade refuses on divergence/dirty tree and migrates before
        # swapping the running containers.
        upgrade) safe_upgrade ;;
        deploy-current) deploy_current ;;
        repair) bash "${INSTALL_DIR}/installer/install.sh" --repair ;;
        reinstall) bash "${INSTALL_DIR}/installer/install.sh" --reinstall ;;
        uninstall) bash "${INSTALL_DIR}/installer/install.sh" --uninstall ;;
        *) die "Unsupported installer action: ${mode:-<empty>}" ;;
    esac
}

BACKUP_ARCHIVE=""

backup_manifest() {
    python3 "${INSTALL_DIR}/app/flowhub/backup/manifest.py" "$@"
}

# The migration head declared by the code currently in the deployed app
# image (reads the Alembic version scripts baked into that image - not the
# database). Whatever revision is newest in alembic_flowhub/versions/ at
# build time is what this reports, automatically, with nothing to update
# here when a new migration is added.
current_migration_head() {
    run_compose exec -T app alembic -c alembic_flowhub.ini heads 2>/dev/null | awk 'NR == 1 { print $1 }'
}

# The migration revision actually applied to the database right now.
current_migration_applied() {
    run_compose exec -T app alembic -c alembic_flowhub.ini current 2>/dev/null | awk 'NR == 1 { print $1 }'
}

create_backup() {
    local label="${1:-backup}"
    [[ "$label" =~ ^[A-Za-z0-9_-]+$ ]] || die "backup label contains unsupported characters."
    mkdir -p "${INSTALL_DIR}/backups"
    chmod 750 "${INSTALL_DIR}/backups" 2>/dev/null || true
    local stamp archive tmpdir migration_head
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    archive="${INSTALL_DIR}/backups/flowhub-${label}-${stamp}.tar.gz"
    load_env
    [[ -f "${INSTALL_DIR}/.env" ]] || die "environment file is required for backup."
    [[ -d "${INSTALL_DIR}/storage" ]] || die "storage directory is required for backup."
    tmpdir="$(mktemp -d "${INSTALL_DIR}/backups/.backup.XXXXXX")"
    chmod 700 "$tmpdir"
    if ! run_compose exec -T postgres pg_dump \
        -U "${FLOWHUB_POSTGRES_USER:-flowhub}" \
        -d "${FLOWHUB_POSTGRES_DB:-flowhub}" \
        --clean --if-exists > "${tmpdir}/postgres.sql"; then
        rm -rf "$tmpdir"
        die "database backup failed; archive was not created."
    fi
    cp -a "${INSTALL_DIR}/.env" "${tmpdir}/.env"
    cp -a "${INSTALL_DIR}/storage" "${tmpdir}/storage"
    if [[ -d "${INSTALL_DIR}/logs" ]]; then
        mkdir -p "${tmpdir}/logs"
        tar --exclude='admin-credentials.txt' -C "${INSTALL_DIR}/logs" -cf - . | tar -C "${tmpdir}/logs" -xf -
    fi
    migration_head="$(current_migration_head)"
    [[ -n "$migration_head" ]] || {
        rm -rf "$tmpdir"
        die "could not determine the current migration head; archive was not created."
    }
    if ! backup_manifest create --root "$tmpdir" \
        --application-version "${FLOWHUB_VERSION:-1.0.0}" \
        --migration-head "$migration_head"; then
        rm -rf "$tmpdir"
        die "backup manifest generation failed; archive was not created."
    fi
    tar -C "$tmpdir" -czf "$archive" .
    rm -rf "$tmpdir"
    chmod 600 "$archive"
    BACKUP_ARCHIVE="$archive"
    echo "Backup created: ${archive}"
}

restore_database_dump() {
    local dump_path="$1"
    load_env
    run_compose exec -T postgres psql \
        -v ON_ERROR_STOP=1 \
        --single-transaction \
        -U "${FLOWHUB_POSTGRES_USER:-flowhub}" \
        -d "${FLOWHUB_POSTGRES_DB:-flowhub}" < "$dump_path"
}

restore_database_from_archive() {
    local archive="$1"
    local tmpdir
    tmpdir="$(mktemp -d "${INSTALL_DIR}/backups/.recovery.XXXXXX")"
    if ! backup_manifest validate-archive --archive "$archive" ||
        ! tar -xzf "$archive" -C "$tmpdir" ||
        ! backup_manifest validate --root "$tmpdir" ||
        ! restore_database_dump "${tmpdir}/postgres.sql"; then
        rm -rf "$tmpdir"
        return 1
    fi
    rm -rf "$tmpdir"
}

apply_restored_files() {
    local staging_dir="$1"
    local rollback_dir="$2"
    mkdir -p "$rollback_dir"
    mv "${INSTALL_DIR}/.env" "${rollback_dir}/.env"
    mv "${INSTALL_DIR}/storage" "${rollback_dir}/storage"
    mv "${staging_dir}/.env" "${INSTALL_DIR}/.env"
    mv "${staging_dir}/storage" "${INSTALL_DIR}/storage"
    chmod 600 "${INSTALL_DIR}/.env"
}

restore_live_files() {
    local rollback_dir="$1"
    local failed_dir="$2"
    mkdir -p "$failed_dir"
    [[ -e "${INSTALL_DIR}/.env" ]] && mv "${INSTALL_DIR}/.env" "${failed_dir}/.env"
    [[ -e "${INSTALL_DIR}/storage" ]] && mv "${INSTALL_DIR}/storage" "${failed_dir}/storage"
    [[ -e "${rollback_dir}/.env" ]] && mv "${rollback_dir}/.env" "${INSTALL_DIR}/.env"
    [[ -e "${rollback_dir}/storage" ]] && mv "${rollback_dir}/storage" "${INSTALL_DIR}/storage"
    [[ -f "${INSTALL_DIR}/.env" ]] && chmod 600 "${INSTALL_DIR}/.env"
}

restore_backup() {
    local archive="${1:-}"
    [[ -n "$archive" && -f "$archive" ]] || die "restore requires a backup archive path."
    local staging_dir rollback_dir failed_dir safety_archive
    backup_manifest validate-archive --archive "$archive" || die "backup archive validation failed."
    staging_dir="$(mktemp -d "${INSTALL_DIR}/backups/.restore.XXXXXX")"
    if ! tar -xzf "$archive" -C "$staging_dir" || ! backup_manifest validate --root "$staging_dir"; then
        rm -rf "$staging_dir"
        die "backup archive is incomplete or failed checksum validation."
    fi
    create_backup "pre-restore"
    safety_archive="$BACKUP_ARCHIVE"
    if ! restore_database_dump "${staging_dir}/postgres.sql"; then
        rm -rf "$staging_dir"
        die "database restore failed; live files were not changed."
    fi
    rollback_dir="$(mktemp -d "${INSTALL_DIR}/backups/.rollback.XXXXXX")"
    failed_dir="$(mktemp -d "${INSTALL_DIR}/backups/.failed.XXXXXX")"
    if ! apply_restored_files "$staging_dir" "$rollback_dir"; then
        restore_live_files "$rollback_dir" "$failed_dir" || true
        if ! restore_database_from_archive "$safety_archive"; then
            die "restore finalization failed and automatic database recovery failed; use ${safety_archive}."
        fi
        die "restore finalization failed; the previous production state was restored."
    fi
    rm -rf "$staging_dir" "$rollback_dir" "$failed_dir"
    echo "Backup restored. Run: flowhub repair"
}

validate_domain() {
    local domain="${1:-}"
    [[ -n "$domain" ]] || die "Domain is required."
    [[ "$domain" != http://* && "$domain" != https://* ]] || die "Enter only the host, for example: kharidbezan.com"
    [[ "$domain" != *"/"* && "$domain" != *":"* && "$domain" != *" "* ]] || die "Domain must be a hostname without scheme, port, path, or spaces."
    [[ "$domain" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)*[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] \
        || die "Invalid domain host: ${domain}"
}

validate_port() {
    local port="${1:-}"
    [[ "$port" =~ ^[0-9]+$ ]] || die "Port must be a number."
    (( port >= 1 && port <= 65535 )) || die "Port must be between 1 and 65535."
}

validate_ip() {
    local ip="${1:-}"
    [[ -n "$ip" ]] || die "IP address is required."
    [[ "$ip" != *" "* && "$ip" != *":"* && "$ip" != *"/"* ]] || die "IP address must not contain spaces, ports, or paths."
    if [[ "$ip" == "localhost" ]]; then
        return 0
    fi
    if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        local IFS=.
        local -a parts
        read -r -a parts <<< "$ip"
        for part in "${parts[@]}"; do
            (( part >= 0 && part <= 255 )) || die "Invalid IPv4 address: ${ip}"
        done
        return 0
    fi
    die "Invalid IP address: ${ip}"
}

validate_ssl_mode() {
    case "${1:-}" in
        off|self-signed|letsencrypt|manual) ;;
        *) die "TLS mode must be one of: off, self-signed, letsencrypt, manual." ;;
    esac
}

set_env_field() {
    local key="${1:-}" value="${2:-}"
    [[ -n "$key" ]] || die "Environment key is required."
    [[ -f "$ENV_FILE" ]] || die "Environment file not found: ${ENV_FILE}"

    local tmp
    tmp="$(mktemp)"
    if grep -qE "^${key}=" "$ENV_FILE"; then
        awk -v key="$key" -v value="$value" 'BEGIN { done=0 } $0 ~ "^" key "=" { print key "=" value; done=1; next } { print } END { if (!done) print key "=" value }' "$ENV_FILE" > "$tmp"
    else
        cat "$ENV_FILE" > "$tmp"
        printf '%s=%s\n' "$key" "$value" >> "$tmp"
    fi
    install -o root -g root -m 0600 "$tmp" "$ENV_FILE"
    rm -f "$tmp"
}

set_domain() {
    local domain="${1:-}"
    validate_domain "$domain"
    set_env_field "FLOWHUB_DOMAIN" "$domain"
    echo "Domain updated: ${domain}"
    echo "Run: flowhub start"
}

set_port() {
    local port="${1:-}"
    validate_port "$port"
    set_env_field "FLOWHUB_PORT" "$port"
    echo "Port updated: ${port}"
    echo "Run: flowhub start"
}

set_domain_ssl() {
    local domain="${1:-}" port="${2:-}"
    validate_domain "$domain"
    validate_port "$port"
    set_env_field "FLOWHUB_DOMAIN" "$domain"
    set_env_field "FLOWHUB_PORT" "$port"
    set_env_field "FLOWHUB_SSL_MODE" "letsencrypt"
    set_env_field "FLOWHUB_BIND_IP" "0.0.0.0"
    echo "Base URL: https://${domain}:${port}/"
    echo "TLS mode: letsencrypt"
    echo "Run: flowhub start"
}

set_ip_port() {
    local ip="${1:-}" port="${2:-}"
    validate_ip "$ip"
    validate_port "$port"
    set_env_field "FLOWHUB_BIND_IP" "$ip"
    set_env_field "FLOWHUB_DOMAIN" "$ip"
    set_env_field "FLOWHUB_PORT" "$port"
    set_env_field "FLOWHUB_SSL_MODE" "off"
    echo "Base URL: http://${ip}:${port}/"
    echo "TLS mode: off"
    echo "Run: flowhub start"
}

status_overview() {
    echo "Database: $(database_state)"
    echo "Panel: $(panel_state)"
    echo "API: $(api_state)"
}

recent_logs() {
    run_compose logs --tail="${1:-120}" app
}

recent_errors() {
    local output
    output="$(run_compose logs --tail="${1:-240}" app 2>&1 | grep -Ei 'error|warning|warn|failed|exception|traceback' || true)"
    if [[ -n "$output" ]]; then
        printf '%s\n' "$output"
    else
        echo "No recent errors or warnings found."
    fi
}

tls_status() {
    load_env
    echo "TLS mode: ${FLOWHUB_SSL_MODE:-off}"
    echo "Domain: ${FLOWHUB_DOMAIN:-localhost}"
    echo "Public URL: $(public_url)"
    case "${FLOWHUB_SSL_MODE:-off}" in
        letsencrypt)
            echo "Let's Encrypt mode is configured for external reverse-proxy termination."
            echo "Certificate issuance is handled by the reverse proxy; FlowHub does not store certificate private keys."
            ;;
        manual)
            echo "Manual TLS mode is configured for external reverse-proxy termination."
            ;;
        self-signed)
            echo "Self-signed TLS mode is configured."
            ;;
        off|*)
            echo "TLS mode is off. Use 'flowhub tls letsencrypt <domain>' after DNS points to this host and a reverse proxy is ready."
            ;;
    esac
}

tls_letsencrypt() {
    local domain="${1:-}"
    local port="${FLOWHUB_PORT:-8085}"
    validate_domain "$domain"
    load_env
    port="${FLOWHUB_PORT:-8085}"
    set_env_field "FLOWHUB_DOMAIN" "$domain"
    set_env_field "FLOWHUB_SSL_MODE" "letsencrypt"
    echo "Let's Encrypt mode configured for: ${domain}"
    echo "Public URL: https://${domain}:${port}/"
    echo "Configure your external reverse proxy to request and renew the certificate for ${domain}."
    echo "Run: flowhub start"
}

tls_set_mode() {
    local mode="${1:-}"
    validate_ssl_mode "$mode"
    set_env_field "FLOWHUB_SSL_MODE" "$mode"
    echo "TLS mode updated: ${mode}"
    echo "Run: flowhub start"
}

require_root
cmd="${1:-}"
shift || true

case "$cmd" in
    state)
        ensure_install
        case "${1:-}" in
            app) install_state ;;
            database) database_state ;;
            api) api_state ;;
            panel) panel_state ;;
            safety) echo "Read-only" ;;
            public-url) public_url ;;
            docker) docker_state ;;
            version) version_commit ;;
            *) die "Unsupported state field: ${1:-<empty>}" ;;
        esac
        ;;
    status)
        ensure_install
        run_compose ps "$@"
        ;;
    health)
        ensure_install
        curl -fsS "$(health_url)"
        echo
        ;;
    start)
        ensure_install
        run_compose up -d "$@"
        wait_for_app_health 60
        ;;
    restart)
        ensure_install
        run_compose restart "$@"
        wait_for_app_health 60
        ;;
    stop)
        ensure_install
        run_compose stop "$@"
        ;;
    logs)
        ensure_install
        service="${1:-app}"
        case "$service" in
            app|postgres) run_compose logs -f "$service" ;;
            recent) recent_logs "${2:-120}" ;;
            errors) recent_errors "${2:-240}" ;;
            *) die "Unsupported log service: ${service}" ;;
        esac
        ;;
    backup)
        ensure_install
        create_backup
        ;;
    restore)
        ensure_install
        restore_backup "$@"
        ;;
    config)
        ensure_install
        case "${1:-}" in
            set-domain) set_domain "${2:-}" ;;
            set-port) set_port "${2:-}" ;;
            set-domain-ssl) set_domain_ssl "${2:-}" "${3:-}" ;;
            set-ip-port) set_ip_port "${2:-}" "${3:-}" ;;
            *) die "Unsupported config command: ${1:-<empty>}" ;;
        esac
        ;;
    base-url)
        ensure_install
        public_url
        ;;
    overview)
        ensure_install
        status_overview
        ;;
    tls)
        ensure_install
        case "${1:-}" in
            status) tls_status ;;
            letsencrypt) tls_letsencrypt "${2:-}" ;;
            mode) tls_set_mode "${2:-}" ;;
            off) tls_set_mode off ;;
            *) die "Unsupported TLS command: ${1:-<empty>}" ;;
        esac
        ;;
    app-cli)
        ensure_install
        run_app_cli "$@"
        ;;
    installer)
        ensure_install
        run_installer "$@"
        ;;
    *)
        die "Unsupported helper command: ${cmd:-<empty>}"
        ;;
esac
