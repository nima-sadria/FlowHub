        <mxCell id="v25" value="⚠ TARGET / PROPOSED (not VERIFY) — Workspace/Review business-event coverage is confirmed absent and deferred; no producer exists. Orders and Exchange Rates producers are likewise deferred TARGET, not built in v1." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1;dashed=1;fontSize=11;fontColor=#78350f;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
