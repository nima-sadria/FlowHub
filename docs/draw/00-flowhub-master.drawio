        <mxCell id="v19" value="✓ CONFIRMED — test_no_direct_httpx, test_shared_write_authority, test_release_terms_guard, test_gateway all exist and now run in CI (see confirmed Architecture Guard CI flow below)." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1;dashed=0;fontSize=11;fontColor=#14532d;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
