        <mxCell id="v6" value="✓ CONFIRMED (current 4) — WooCommerce, SnappShop, TapsiShop, Technolife all implement WorkspaceChannelConnector via the Channel Gateway. Same contract for future channels (Digikala, Shopify): ⚠ VERIFY." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1;dashed=0;fontSize=11;fontColor=#14532d;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
