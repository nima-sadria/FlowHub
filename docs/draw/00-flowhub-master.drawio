        <mxCell id="business_event_contract" value="STRUCTURED BUSINESS EVENT CONTRACT&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:bold;color:#0e7490&quot;&gt;IMPLEMENTED_UNVERIFIED (v1 domains)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;Capability / domain &amp;nbsp;•&amp;nbsp; Severity (separate) &amp;nbsp;•&amp;nbsp; Business impact (separate) &amp;nbsp;•&amp;nbsp; Reason&lt;br&gt;Affected scope: primary + secondary &amp;nbsp;•&amp;nbsp; Recommended operator action + stable action route &amp;nbsp;•&amp;nbsp; Timestamp / correlation reference&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;dashed=0;fontStyle=1;fontSize=13;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="430" y="3306" width="680" height="115" as="geometry" />
        </mxCell>
        <mxCell id="source_event_example" value="SOURCE EXAMPLE&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;Source acquisition failed&lt;br&gt;→ Source data is stale&lt;br&gt;→ Reason&lt;br&gt;→ Affected source&lt;br&gt;→ Review Source&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0891b2;strokeWidth=1.2;fontStyle=1;fontSize=11;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="430" y="3441" width="210" height="155" as="geometry" />
        </mxCell>
        <mxCell id="pricing_event_example" value="PRICING EXAMPLE&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;Pricing apply blocked&lt;br&gt;→ Products not updated&lt;br&gt;→ Reason&lt;br&gt;→ Affected products/channels&lt;br&gt;→ Review Approval&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;strokeWidth=1.2;fontStyle=1;fontSize=11;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="665" y="3441" width="210" height="155" as="geometry" />
        </mxCell>
        <mxCell id="channel_event_example" value="CHANNEL EXAMPLE&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;Channel write failed&lt;br&gt;→ Destination is out of sync&lt;br&gt;→ Reason&lt;br&gt;→ Affected channel/products&lt;br&gt;→ Retry / Review&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.2;fontStyle=1;fontSize=11;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="900" y="3441" width="210" height="155" as="geometry" />
        </mxCell>
        <mxCell id="business_observability_rule" value="ARCHITECTURE RULE&lt;br&gt;&lt;font style=&quot;font-size:13px;font-weight:bold&quot;&gt;Every operator-relevant business capability must emit structured business events containing status, impact, reason, affected scope, and recommended operator action.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;color:#0e7490&quot;&gt;IMPLEMENTED_UNVERIFIED for Source acquisition, Pricing, Channels, Write Pipeline. Orders, Exchange Rates, and Workspace/mapping remain TARGET / PROPOSED.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;dashed=0;fontStyle=1;fontSize=12;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="430" y="3621" width="680" height="120" as="geometry" />
        </mxCell>
        <mxCell id="business_correlation" value="✓ CONFIRMED — correlation_id is standardized and reused within each already-correlated operation: Write Pipeline, Pricing, and Channels events for one execution share that execution's correlation_id; Source events reuse the Source Acquisition Run's own correlation_id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1;dashed=0;fontSize=10;fontColor=#14532d;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="430" y="3761" width="680" height="55" as="geometry" />
        </mxCell>
        <mxCell id="business_correlation_verify" value="⚠ VERIFY — a single correlation_id has not been threaded end-to-end across the full chain: Source → Workspace → Pricing → Review → Write → Channel. Today's within-domain correlation (above) does not by itself link a Source read to the eventual Write/Channel result it fed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1;dashed=1;fontSize=10;fontColor=#78350f;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="430" y="3826" width="680" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pricing_anomaly_target" value="Price Anomaly Detection&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal&quot;&gt;Pricing Intelligence — TARGET / PROPOSED, PHASE 2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal&quot;&gt;Not rejected. app/a2 AdvisoryInsight stays quarantined, not reconnected. Algorithm/thresholds not yet decided.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.3;dashed=1;fontStyle=1;fontSize=11;fontColor=#78350f;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="430" y="3916" width="335" height="75" as="geometry" />
        </mxCell>
        <mxCell id="notifications_target" value="Notifications&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal&quot;&gt;Business Observability — TARGET / FUTURE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal&quot;&gt;Contract reserves room to subscribe by domain/business impact. No delivery mechanism exists (no email/webhook/push in FlowHub today).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.3;dashed=1;fontStyle=1;fontSize=11;fontColor=#78350f;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="775" y="3916" width="335" height="75" as="geometry" />
