        <mxCell id="v1" value="✓ CONFIRMED — SourceHttpClient is the network/security boundary (SSRF protection, private-network allowlist, redirect validation, response limits) for Nextcloud WebDAV/OCS/acquisition reads. A single unified multi-provider Source Gateway abstraction beyond Nextcloud remains ⚠ VERIFY." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1;dashed=0;fontSize=11;fontColor=#14532d;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1395" y="400" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="✓ CONFIRMED (Nextcloud only) — NextcloudConnector implements the SourceConnector contract (app/connectors/sources/nextcloud/connector.py:30 → app/connectors/common/base.py:11). Same contract for CSV/Excel or other providers: ⚠ VERIFY." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1;dashed=0;fontSize=11;fontColor=#14532d;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
