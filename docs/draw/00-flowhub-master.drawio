          <mxGeometry x="1395" y="630" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="✓ CONFIRMED — app.flowhub.channels.gateway.WorkspaceConnectorFactory is the canonical Channel Gateway: WritePipelineService → Channel Gateway → WorkspaceChannelConnector → Channel Providers." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1;dashed=0;fontSize=11;fontColor=#14532d;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1395" y="745" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="✓ CONFIRMED — WritePipelineService remains the single external-write dispatch authority; it calls INTO the Channel Gateway and does not act as the gateway itself." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1;dashed=0;fontSize=11;fontColor=#14532d;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
