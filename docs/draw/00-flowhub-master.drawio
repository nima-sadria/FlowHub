        <mxCell id="v23" value="✓ CONFIRMED — Source business-event coverage: source_acquisition/service.py emits source_read_failed and source_run_abandoned at the two non-success terminal points (fail_run, lease-expiry abandonment)." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1;dashed=0;fontSize=11;fontColor=#14532d;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
