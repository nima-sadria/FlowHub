        </mxCell>
        <mxCell id="v17" value="✓ CONFIRMED — Backend, API, and UI are all real, mounted, and tested for Diagnostics (see v11–v13); no stub-router gap found here." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1;dashed=0;fontSize=11;fontColor=#14532d;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1665" y="400" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v18" value="✓ CONFIRMED — CAPABILITY_REGISTRY.md now has the two-part structure: Part A 10-domain Owner-approved registry plus Appendix A preserved fine-grained Phase 4.2 schema. Governance rule: repository evidence may confirm or downgrade, never silently upgrade. CI / Diagnostics wiring remains TARGET / PROPOSED." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1;dashed=0;fontSize=11;fontColor=#14532d;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" vertex="1" parent="1">
