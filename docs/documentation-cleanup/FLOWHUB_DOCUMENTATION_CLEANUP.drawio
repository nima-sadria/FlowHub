        <mxCell id="rootgrp" value="REPOSITORY ROOT — 23 Markdown files&#xa;Active: README, CHANGELOG, CONTRIBUTING, CODE_OF_CONDUCT, SECURITY, SUPPORT&#xa;Protected: FRONTEND_CONTRACT, OPERATIONS_RUNBOOK, release/process docs&#xa;Historical / transient: ARCHITECTURE_STATE, PROJECT_*, RESUME*, UI_RESUME, NEXT_TASK, ROADMAP*, RELEASE_NOTES, PRICING_FORMULA_MIGRATION_ROADMAP&#xa;Root policy: retain only genuinely repository-level files after approved migration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#DC2626;strokeWidth=3;fontSize=13;align=left;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="630" height="180" as="geometry"/></mxCell>
