        <mxCell id="pd-commentdocs" value="Protected architecture / workspace / UI documents&#xa;FRONTEND_CONTRACT.md&#xa;docs/architecture/PRICING_UI_CONTRACT.md&#xa;docs/architecture/ADR_PRICING_MATRIX.md&#xa;docs/workspace-adoption/WORKSPACE_CANONICAL_OWNER_SPEC_2026-08-22.md&#xa;docs/workspace-adoption/WORKSPACE_OWNER_DECISIONS.md&#xa;RESUME.md; UI_RESUME.md; README-linked architecture docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#DC2626;strokeWidth=3;fontSize=12;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1840" y="680" width="430" height="235" as="geometry"/></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="pd-comments" target="pd-commentdocs" style="endArrow=block;html=1;strokeColor=#DC2626;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd-validation" value="Required future validation after a protected move&#xa;1. Search old path and basename references.&#xa;2. Update consumers in the same commit.&#xa;3. Run focused frontend / Docker / script / installer / plugin / test check.&#xa;4. Confirm rendered Docs path and git mv history.&#xa;5. Run repository link/reference scan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=13;align=left;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="970" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="authority" name="5 — Authority Model">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="am-title" value="FINAL DOCUMENTATION AUTHORITY MODEL" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="40" as="geometry"/></mxCell>
        <mxCell id="am-canon" value="docs/canonical/&#xa;SINGLE ARCHITECTURAL AUTHORITY&#xa;Frozen Phase A files remain here.&#xa;Architectural concepts, ownership, invariants and boundaries live only here once ratified." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=3;fontSize=16;align=center;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="am-op" value="docs/operations/&#xa;CURRENT OPERATIONAL PROCEDURES&#xa;Runbooks, install, upgrade, backup, troubleshooting, current release/rollback." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="am-dev" value="docs/development/&#xa;IMPLEMENTATION / CONTRIBUTOR GUIDANCE&#xa;Agents, contracts, API development guidance, i18n, design, plugins." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="500" y="390" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="am-ref" value="docs/reference/&#xa;PRODUCT / RUNTIME REFERENCE ASSETS&#xa;Channel API Markdown stays active because product runtime consumes it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;strokeWidth=2;fontSize=14;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="930" y="390" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="am-product" value="docs/product/&#xa;CURRENT PRODUCT GUIDES&#xa;Reserved distinct location; product content is not Canon by default." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;strokeWidth=2;fontSize=14;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1360" y="390" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="am-evidence" value="docs/evidence/&#xa;HISTORICAL ARCHITECTURE / DESIGN EVIDENCE&#xa;ADRs, earlier architecture, workspace plans, reports, owner directives.&#xa;EVIDENCE ONLY — NO ARCHITECTURAL AUTHORITY." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;fontSize=16;align=center;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="390" y="660" width="540" height="155" as="geometry"/></mxCell>
        <mxCell id="am-archive" value="docs/archive/&#xa;RETAINED TRANSIENT HISTORY&#xa;Legacy placeholders, handoffs, roadmaps, old plans and status material.&#xa;NO CURRENT AUTHORITY; no deletion proposed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=3;fontSize=16;align=center;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1100" y="660" width="540" height="155" as="geometry"/></mxCell>
        <mxCell id="am-rule" value="CRITICAL DISTINCTION&#xa;SUPERSEDED ARCHITECTURE: existing pre-Canon architecture/design material loses architectural authority and is preserved in evidence or archive.&#xa;&#xa;ACTIVE NON-ARCHITECTURAL DOCUMENTATION: operational procedures, development guidance, channel-runtime assets, and contributor workflow remain authoritative within their own scope. They are not superseded merely because Canon exists." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=3;fontSize=15;align=left;spacingLeft=14;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="350" y="960" width="1330" height="165" as="geometry"/></mxCell>
        <mxCell id="am-e1" edge="1" parent="1" source="am-canon" target="am-evidence" style="endArrow=block;html=1;strokeColor=#D97706;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="am-e2" edge="1" parent="1" source="am-canon" target="am-archive" style="endArrow=block;html=1;strokeColor=#6B7280;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sequence" name="6 — Safe Cleanup Execution">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="se-title" value="SAFE CLEANUP EXECUTION — future task only; no cleanup authorized by this diagram" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1900" height="40" as="geometry"/></mxCell>
        <mxCell id="b0" value="BATCH 0 — OWNER APPROVES THIS DRAW.IO&#xa;Gate: explicit approval; Canon Phase A remains frozen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=3;fontSize=15;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="600" height="85" as="geometry"/></mxCell>
        <mxCell id="b1" value="BATCH 1 — Create authority/index structure&#xa;Create folders and supersession index only. No pre-Canon move yet.&#xa;Validation: tree review; Canon paths unchanged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#374151;fontSize=14;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="700" y="270" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="b2" value="BATCH 2 — Stabilize active operational documentation&#xa;Resolve installation / backup ownership decisions before move.&#xa;Validation: procedure review; no production access or deployment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="700" y="455" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="b3" value="BATCH 3 — Move runtime/reference docs with consumer updates&#xa;Channel APIs + workspace API docs.&#xa;Validation: frontend import/build, Docker context test, link scan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#DC2626;strokeWidth=3;fontSize=14;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="700" y="640" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="b4" value="BATCH 4 — Rehome active development documentation&#xa;Agents, contracts, i18n, design, plugins.&#xa;Validation: contributor/automation reference scan and focused tests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=14;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="700" y="825" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="b5" value="BATCH 5 — Move pre-Canon architecture/design to evidence&#xa;Only after all code/test/comment/README references are migrated.&#xa;Validation: architecture reference scan; Canon supersession index complete." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#DC2626;strokeWidth=3;fontSize=14;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="700" y="1010" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="b6" value="BATCH 6 — Archive legacy compatibility placeholders&#xa;Only after scripts, installer, plugins and tests no longer use legacy paths.&#xa;Validation: targeted script/installer/plugin/test checks; git mv history." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#DC2626;strokeWidth=3;fontSize=14;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="700" y="1195" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="b7" value="BATCH 7 — Archive transient handoffs / roadmaps&#xa;Validation: search comments/tests; update or remove only with explicit owner approval.&#xa;No deletion in this program." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;fontSize=14;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="700" y="1380" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="final" value="VALIDATION → FINAL CLEAN DOCUMENTATION TREE&#xa;Run complete Markdown reference/link scan, focused tests, git diff/history review, and Owner sign-off.&#xa;Future moves use git mv. No deletion, production access, deployment, or hygiene cleanup is part of this plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=3;fontSize=15;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="620" y="1570" width="760" height="115" as="geometry"/></mxCell>
        <mxCell id="s1" edge="1" parent="1" source="b0" target="b1" style="endArrow=block;html=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2" edge="1" parent="1" source="b1" target="b2" style="endArrow=block;html=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s3" edge="1" parent="1" source="b2" target="b3" style="endArrow=block;html=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4" edge="1" parent="1" source="b3" target="b4" style="endArrow=block;html=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s5" edge="1" parent="1" source="b4" target="b5" style="endArrow=block;html=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s6" edge="1" parent="1" source="b5" target="b6" style="endArrow=block;html=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s7" edge="1" parent="1" source="b6" target="b7" style="endArrow=block;html=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s8" edge="1" parent="1" source="b7" target="final" style="endArrow=block;html=1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
